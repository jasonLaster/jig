  "audit": {
    "toleranceMm": 0.5,
    "dimensionTargets": [
      "The default tabletop is 96 in long by 40 in wide by 1 1/2 in thick and the finished table is 30 in high.",
      "The default advanced flush base uses eight 1 1/2 in thick profiled leg halves, mitered in pairs into four L-shaped corner legs.",
      "Each advanced leg profile is 6 in wide at the frame, begins its shoulder 2 1/2 in below the top, and tapers to a 2 in foot.",
      "All advanced aprons and stretchers are 1 1/2 in thick by 2 1/2 in deep; long aprons are table length minus 12 in, short aprons are table width minus 12 in, and stretchers are table width minus 3 in.",
      "Three cross stretchers use the centerline plus two positions 22 in on center from it.",
      "The flush top uses a 1/2 in wide by 1/4 in deep perimeter shadow groove; the alternate top uses a default 1 1/2 in overhang.",
      "The documented simple and intermediate alternatives use 2 1/2 in leg blanks and 1 1/4 in thick frame members."
    ],
    "invariants": [
      "Keep full-size dimensions independent from the mock scale denominator.",
      "Derive every apron and stretcher length from the editable table and style parameters.",
      "Keep the advanced corner legs as continuous closed L-shaped solids with mirrored curved shoulders.",
      "Keep the simple, intermediate, and advanced leg options registered to the same base and tabletop envelope.",
      "Keep the flush shadow groove and overhang option mutually exclusive and derived from the selected top style.",
      "Keep the tabletop, four legs, four aprons, and three stretchers as closed printable solids.",
      "Keep the four independent leveling feet on Z = 0 and shorten the wood while preserving overall table height.",
      "Keep oak grain aligned lengthwise on the tabletop and long aprons, crosswise on short members, and vertically on legs.",
      "Treat the source PDF as supplemental dimensional guidance and omit construction details that are not dimensioned.",
      "Treat the structural panel as a geometry-only comparison and require full-size joint, racking, rocking, deflection, and repeated-load tests before build approval.",
      "Export registered support-free wood and hardware STLs while leveling feet are enabled; disabling them restores direct wood floor contact."
    ],
    "checks": [
      { "key": "tableEnvelope", "label": "Plan envelope" },
      { "key": "tabletopProfile", "label": "Top style and shadow detail" },
      { "key": "legGeometry", "label": "Leg style and profile" },
      { "key": "legEndRoundovers", "label": "Floor-contact system" },
      { "key": "cornerPlates", "label": "Apron frame" },
      { "key": "channelLayout", "label": "Three-stretcher layout" },
      { "key": "printEnvelope", "label": "Mock print envelope" },
      { "key": "minimumMockFeature", "label": "Smallest mock feature" }
    ]
  },
  "scripts": [
